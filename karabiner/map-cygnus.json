{
  "description": "Windows-style Control: Clipboard, Navigation, Search, Refresh, and Terminal Kill",
  "manipulators": [
    {
      "description": "Ctrl + C, V, X, A, F, R to Command equivalents",
      "from": {
        "key_code": "c",
        "modifiers": {
          "mandatory": ["left_control"],
          "optional": ["any"]
        }
      },
      "to": [
        {
          "key_code": "c",
          "modifiers": ["left_command"]
        }
      ],
      "type": "basic"
    },
    {
      "from": {
        "key_code": "v",
        "modifiers": {
          "mandatory": ["left_control"],
          "optional": ["any"]
        }
      },
      "to": [
        {
          "key_code": "v",
          "modifiers": ["left_command"]
        }
      ],
      "type": "basic"
    },
    {
